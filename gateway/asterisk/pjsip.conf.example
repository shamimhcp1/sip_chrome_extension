; WS<->UDP SIP gateway bridging the Chrome extension (WebRTC + SIP-over-WS)
; to the Dinstar UC200 Pro (SIP-over-UDP only). Codecs are pinned to G.711
; (ulaw/alaw) on both sides so no codec transcoding is needed — Chrome's
; WebRTC stack negotiates PCMU/PCMA natively, and it's what the UC200 Pro
; extension already uses. Copy this file to pjsip.conf and fill in the
; placeholders before deploying; do not commit real credentials.

[global]
type=global
user_agent=sip-chrome-extension-gateway

; ---- Transport: browser side (SIP-over-WebSocket) ----

[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0

; ---- Transport: PBX side (plain UDP, LAN-only) ----

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
; Without these, Asterisk advertises its own Docker bridge IP (e.g.
; 172.18.0.2) in the Contact header and SDP of outbound requests instead of
; the host's real LAN IP — confirmed live: the outbound INVITE to the UC200
; Pro carried "Contact: <sip:201@172.18.0.2:5060>" and
; "c=IN IP4 172.18.0.2", both unreachable from the UC200 Pro, and it
; immediately rejected the call with 403 Forbidden. external_signaling_address
; makes Asterisk rewrite Contact/Via to the host's real LAN IP for anything
; outside local_net; external_media_address does the same for the SDP.
; Replace 192.168.0.201 with whatever LAN IP this gateway host actually has,
; and adjust local_net if your Docker/LAN subnet differs.
external_signaling_address=192.168.0.201
external_media_address=192.168.0.201
local_net=172.16.0.0/12
local_net=192.168.0.0/16

; ---- Browser-facing endpoint (what the extension registers as) ----

[browser-ext]
type=endpoint
transport=transport-ws
context=from-browser
disallow=all
allow=ulaw
allow=alaw
webrtc=yes
dtls_auto_generate_cert=yes
rtcp_mux=yes
auth=browser-ext-auth
aors=browser-ext

[browser-ext-auth]
type=auth
auth_type=userpass
username=browser-ext
password=CHANGE_ME_BROWSER_PASSWORD

; Confirmed against a live Asterisk instance: the AOR name must equal the
; account name in the REGISTER's To-header (here, "browser-ext") — Asterisk's
; registrar looks up the AOR by that exact identity, not merely by whatever
; name is listed in the endpoint's aors= field. A differently-named AOR
; (e.g. "browser-ext-aor") fails registration with
; "find_registrar_aor: AOR '' not found for endpoint ..." even though the
; endpoint and AOR both load correctly and auth succeeds. Reusing the same
; section name "browser-ext" for both type=endpoint and type=aor (as done
; here) is safe — verified via `pjsip show endpoint` / `pjsip show aor`
; that both load with the expected fields, no config-parsing conflict.
[browser-ext]
type=aor
max_contacts=1

; ---- Dinstar UC200 Pro side: register as extension 201 ----
; Replace 192.168.0.110 with the UC200 Pro's LAN address, 201 with the
; extension number, and CHANGE_ME_UC200_PASSWORD with that extension's
; SIP password (the same one used in MicroSIP's "Password" field).

[uc200-auth]
type=auth
auth_type=userpass
username=201
password=CHANGE_ME_UC200_PASSWORD

[uc200-aor]
type=aor
contact=sip:201@192.168.0.110:5060

[uc200]
type=endpoint
transport=transport-udp
context=from-uc200
disallow=all
allow=ulaw
allow=alaw
outbound_auth=uc200-auth
aors=uc200-aor
; Without these, outbound INVITEs keep the original caller's From header
; (sip:browser-ext@<gateway-ip>) instead of extension 201's identity.
; Confirmed live: the UC200 Pro rejects that with "403 Forbidden" — it only
; accepts calls that claim to come from the extension it has registered.
from_user=201
from_domain=192.168.0.110

[uc200-identify]
type=identify
endpoint=uc200
match=192.168.0.110

[uc200-registration]
type=registration
transport=transport-udp
outbound_auth=uc200-auth
server_uri=sip:192.168.0.110
client_uri=sip:201@192.168.0.110
retry_interval=60
; contact_user belongs here (type=registration), not on the [uc200] endpoint
; — the endpoint has no bearing on the outbound REGISTER's Contact header.
; Confirmed live: `pjsip show registration uc200-registration` lists
; contact_user as a parameter of the registration object itself, and it was
; sitting blank even after being set on the endpoint — so the UC200 Pro kept
; getting a random Contact user and routed inbound calls to 201 nowhere,
; failing dialplan lookup with "extension not found in context 'from-uc200'"
; trying 's'. Pin it here so inbound calls route to extension 201 correctly.
contact_user=201
